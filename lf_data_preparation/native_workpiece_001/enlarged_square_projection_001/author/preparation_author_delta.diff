+def qualified_controller(root, inherited, files):
+    """Read the two-source initialization proof only; no model or solver calls."""
+    control = root/"lf_data_preparation/native_workpiece_001/port_projection_validation_001"
+    assert files == [control/"protocol.json", control/"validation_launch.json", control/"result/receipt.json"]
+    protocol, launch, receipt = (read(file) for file in files)
+    keys = {"hf_repo/src/hf_eval/native_mean.py", "hf_repo/src/hf_eval/split_displacement.py"}
+    transitions = protocol["source_transition"]
+    assert isinstance(transitions, list) and len(transitions) == 2 and {item["path"] for item in transitions} == keys
+    assert receipt["source_transition"] == transitions
+    for item in transitions:
+        key = item["path"]
+        assert item == dict(path=key, previous_sha256=inherited[key], current_sha256=digest(root/key),
+            proof_kind="port_projection_initialization")
+        assert item["previous_sha256"] != item["current_sha256"] == protocol["bindings"][key]
+    assert protocol["phases"]["validation"]["helper_seconds"] == 180 and protocol["phases"]["validation"]["outer_seconds"] == 240
+    assert protocol["sampled_RSS_bytes"] == RSS_LIMIT
+    assert launch["status"] == receipt["status"] == "pass" and launch["exit_code"] == 0
+    assert launch["invocations"] == 1 and launch["stop_reason"] is None and launch["all_bindings_unchanged"]
+    assert launch["protocol_sha256"] == digest(files[0]) and launch["outer_seconds"] == 240
+    assert launch["elapsed_seconds"] <= 240 and launch["sampled_RSS_limit_bytes"] == RSS_LIMIT
+    assert launch["peak_sampled_tree_RSS_bytes"] <= RSS_LIMIT
+    assert receipt["pytest_invocations"] == 1 and receipt["pytest_exit_code"] == 0
+    assert protocol["expected_tests"] == 15 and receipt["tests_passed"] == receipt["tests"]["tests"] == 15
+    assert all(receipt["tests"][key] == 0 for key in ("errors", "failures", "skipped"))
+    assert all(receipt[key] == 0 for key in ("tests_failed", "tests_errors", "tests_skipped", "full_HF_solver_calls", "HP_calls"))
+    assert receipt["all_bindings_unchanged"] and receipt["default_initial_guess_preserved"]
+    assert receipt["production_force_changed"] is False and receipt["force_tangent_gates_changed"] is False
+    assert receipt["elapsed_seconds"] <= 180 and receipt["peak_sampled_RSS_bytes"] <= RSS_LIMIT
+    assert all(digest(root/name) == pin for name, pin in protocol["bindings"].items())
+    return transitions
+
+
