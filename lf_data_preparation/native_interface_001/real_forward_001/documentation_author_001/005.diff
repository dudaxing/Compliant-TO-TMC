+---
+
+以下完整原字节为8330b821阶段功能矩阵历史；当前变化以上方为准。
+
+"""
+
+
+def propose(repo, output):
+    assert not output.exists(), output
+    data = gather(repo)
+    baseline_index = json.loads((AUTHOR / "baseline_index.json").read_bytes())
+    payloads = {}
+    before = {}
+    for destination in DOCS:
+        entry = baseline_index[destination]
+        raw = (AUTHOR / entry["file"]).read_bytes()
+        assert hashlib.sha256(raw).hexdigest() == entry["sha256"]
+        assert (repo / destination).read_bytes() == raw, destination
+        before[destination] = sha(repo / destination)
+        prefix = (current_front(destination, data) if destination in FRONTS else
+                  interface_section(data) if destination.endswith("NATIVE_EVALUATION_INTERFACE.md") else
+                  matrix_section(data))
+        payloads[destination] = prefix.encode("utf-8") + raw
+    progress = {
+        "schema_version": "native-real-api-closure-progress-1.0",
+        "status": "pass", "baseline_commit": BASE,
+        "goal": "Independent HF forward evaluation for external LF/N4 comparison; no optimizer; HF5 remains incomplete.",
+        "case_scope": "Existing coarse gripper, no workpiece, load-only 0 to 0.001mm; not a large-stroke clamp qualification.",
+        "phases": {name: {k: v for k, v in row.items() if k != "receipt"} for name, row in data["records"].items()},
+        "actual_states": data["qualified"]["path"]["accepted_states"],
+        "actual_targets_mm": data["result"]["targets_mm"],
+        "call_counts": data["result"]["call_counts"],
+        "real_delegate_counts": data["records"]["production"]["receipt"]["counts"],
+        "new_HP_calls": data["reference"]["HP_calls_completed"],
+        "checks_completed": data["reference"]["checks_completed"],
+        "target_response": data["qualified"]["target_response"],
+        "last_accepted": data["qualified"]["last_accepted"],
+        "producer_flags": data["qualified"]["producer_flags"],
+        "independent_reference": data["qualified"]["independent_reference"],
+        "views": data["qualified"]["views"],
+        "former_functional_scope": "api_validation_001: first 21 saved-JSON/mock transport tests and four exports; zero real mechanics.",
+        "remaining": ["Matched-design mesh and domain convergence", "Same-task comparison and batch repeatability/HF5",
+                      "Effective contact/clamp criteria and continuous pressure", "Circle task, free body and friction"],
+        "source_json_media_bindings": data["bindings"],
+        "independent_closure_review": {"path": CONTROL + "/closure_author/001.json", "sha256": data["bindings"][CONTROL + "/closure_author/001.json"]},
+        "collector_scope": "Saved JSON/source/media byte audit only; no NPZ/array or HP archive audit and no new HF calls.",
+    }
+    payloads[CONTROL + "/closure_progress.json"] = json_bytes(progress)
+    payloads[CONTROL + "/RESULTS.md"] = results_text(data).encode("utf-8")
+    for destination in payloads.keys() - before.keys():
+        assert not (repo / destination).exists(), destination
+        before[destination] = None
+    output.mkdir()
+    files = []
+    for i, (destination, raw) in enumerate(payloads.items(), 1):
+        short = f"{i:03}" + Path(destination).suffix
+        (output / short).write_bytes(raw)
+        item = {"destination": destination, "proposal": short,
+                "sha256": hashlib.sha256(raw).hexdigest(),
+                "expected_preimage_sha256": before[destination]}
+        if destination in baseline_index:
+            item["preserved_history"] = baseline_index[destination]
+        files.append(item)
+    manifest = {
+        "schema_version": "native-real-api-documentation-proposals-1.0",
+        "status": "proposed", "baseline_commit": BASE,
+        "collector_sha256": sha(__file__), "baseline_index_sha256": sha(AUTHOR / "baseline_index.json"),
+        "input_bindings": data["bindings"], "files": files, "new_scientific_calls": 0,
+    }
+    (output / "proposal_manifest.json").write_bytes(json_bytes(manifest))
+    print(json.dumps({"status": "proposed", "files": len(files),
+                      "manifest": str(output / "proposal_manifest.json"),
+                      "manifest_sha256": sha(output / "proposal_manifest.json")}))
+
+
+def apply(repo, proposals, review_file):
+    manifest_file = proposals / "proposal_manifest.json"
+    manifest = json.loads(manifest_file.read_bytes())
+    review = json.loads(review_file.read_bytes())
+    assert review["status"] == "pass_saved_only" and review["blocking_findings"] == []
+    assert review["proposal_manifest_sha256"] == sha(manifest_file)
+    assert manifest["collector_sha256"] == sha(__file__)
+    assert len(manifest["files"]) == 9
+    for name, expected in manifest["input_bindings"].items():
+        assert Path(name).suffix.lower() != ".npz"
+        assert sha(repo / name) == expected, name
+    # Check all nine proposal/preimage identities before any repository write.
+    for row in manifest["files"]:
+        destination = repo / row["destination"]
+        assert sha(proposals / row["proposal"]) == row["sha256"]
+        expected = row["expected_preimage_sha256"]
+        assert (not destination.exists()) if expected is None else sha(destination) == expected
+        if "preserved_history" in row:
+            entry = row["preserved_history"]
+            old = (AUTHOR / entry["file"]).read_bytes()
+            assert hashlib.sha256(old).hexdigest() == entry["sha256"]
+            assert (proposals / row["proposal"]).read_bytes().endswith(old)
+    archive = repo / CONTROL / "documentation_author_001"
+    assert not archive.exists()
+    receipt_file = repo / CONTROL / "documentation_install.json"
+    assert not receipt_file.exists()
+    selection = [Path(__file__), AUTHOR / "README.md", AUTHOR / "author_note.json",
+                 AUTHOR / "author_checks.json", AUTHOR / "source_additions.diff",
+                 AUTHOR / "documentation_static_review.json", AUTHOR / "baseline_index.json",
+                 manifest_file, review_file]
+    raw_sources = [source.read_bytes() for source in selection]
+    archive.mkdir()
+    archive_map = []
+    for i, (source, raw) in enumerate(zip(selection, raw_sources), 1):
+        short = f"{i:03}" + source.suffix
+        (archive / short).write_bytes(raw)
+        archive_map.append({"file": short, "source_name": str(source),
+                            "sha256": hashlib.sha256(raw).hexdigest()})
+    (archive / "INDEX.json").write_bytes(json_bytes(archive_map))
+    (archive / "INDEX.md").write_text(
+        "# Real API documentation source context\n\n"
+        "Numbered files preserve raw author, static review, proposal manifest and saved-only review. "
+        "Authoring source-only roles are historical. Scientific phase files remain unchanged. "
+        "The seven full 8330 documents are preserved as exact historical suffixes in their current files; "
+        "baseline_index records their raw hashes. External source names are provenance, not runtime dependencies.\n",
+        encoding="utf-8")
+    for row in manifest["files"]:
+        destination = repo / row["destination"]
+        destination.write_bytes((proposals / row["proposal"]).read_bytes())
+        assert sha(destination) == row["sha256"]
+    receipt = {
+        "schema_version": "native-real-api-documentation-install-1.0", "status": "pass",
+        "proposal_manifest_sha256": sha(manifest_file), "review_sha256": sha(review_file),
+        "collector_sha256": sha(__file__), "installed_files": manifest["files"],
+        "archive": (archive.relative_to(repo)).as_posix(), "archive_files": archive_map,
+        "original_input_bindings": manifest["input_bindings"], "new_scientific_calls": 0,
+        "completed_utc": datetime.now(timezone.utc).isoformat(),
+    }
+    receipt_file.write_bytes(json_bytes(receipt))
+    print(json.dumps({"status": "pass", "installed_files": 9, "receipt": str(receipt_file)}))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, required=True)
+    commands = parser.add_subparsers(dest="mode", required=True)
+    proposal = commands.add_parser("propose")
+    proposal.add_argument("--output", type=Path, required=True)
+    install = commands.add_parser("apply")
+    install.add_argument("--proposals", type=Path, required=True)
+    install.add_argument("--review", type=Path, required=True)
+    args = parser.parse_args()
+    repo = args.repo.resolve()
+    if args.mode == "propose":
+        propose(repo, args.output.resolve())
+    else:
+        apply(repo, args.proposals.resolve(), args.review.resolve())
+
+
+if __name__ == "__main__":
+    main()
