"""Add the nearest source-prepared stage; preserve complete prior document bytes."""
from datetime import datetime, timezone
from hashlib import sha256
import json
from pathlib import Path

ROOT = Path('D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC')
EXT = Path('D:/hf-native-workpiece-api-author-20261009/MLEDGER1_source_prepare_001')
STAGE = 'lf_data_preparation/native_interface_001/nested_ledger_001'
LINK = 'lf_data_preparation/native_interface_001/nested_link_001/README.md'
REPORT = EXT/'documentation_receipt.json'
assert not REPORT.exists()
assert (ROOT/STAGE/'author/final_static_review.json').is_file()
assert not (ROOT/STAGE/'run_001').exists()
rows = []
for rel in ('docs/CURRENT_STATUS.md', 'docs/RESUME_DEVELOPMENT.md', LINK, STAGE+'/README.md'):
    path = ROOT/rel
    old = path.read_bytes()
    target = '../'+STAGE+'/' if rel.startswith('docs/') else ('../nested_ledger_001/' if rel == LINK else '')
    prior = '../lf_data_preparation/native_interface_001/nested_link_001/RESULTS.md' if rel.startswith('docs/') else ('RESULTS.md' if rel == LINK else '../nested_link_001/RESULTS.md')
    text = f'''# 当前接续：M-LEDGER1 来源已冻结，待新授权（2026-10-10）

整体目标是独立 HF 有限变形／TMC 前向评估：读取普通几何，得到可核对的反力、工件载荷及实际变形，供外部研究比较。开发继续在 main，origin 为 https://github.com/dudaxing/Compliant-TO-TMC.git。前次 M-LINK1 已实际发布并增量恢复到 `909d7ba6a4bd3ba6bd11b97af830f4aeeef203c7`；细网格完整24态、48次保存态独立参考及原图件保持。原生产资格没有改写。

最近的功能步骤是整理已有 nodes.csv，回答工件载荷来自底边、左右边、角点还是对称切面，以及 total／material／Hu 的有符号分量。新增122行 stdlib 读取函数和151行薄调用脚本，先处理原态0、8、13、23（初始、加载0.95 mm既有最大Hu记录、峰值1.2 mm、卸载0）；完整24态仅用于旧身份登记。七类互斥，角点／交点向量独立保留，原六力文本、厚度已包含的N单位及微小卸载量保持。直接整体 fsum 对账，七类回并沿原8·eps·节点L1舍入合同，无绝对误差地板。

候选源码、输入合同、正式卡／协议已作独立静审；本阶段尚未获执行授权，未调用新读取函数、解析CSV行分类求和、生成图或创建run。预计三张新图为固定工件参考节点分区图（无力箭头）、峰值七类分量柱形图、四个缓存态的分区变化图；四态连线只作阅读引导。源码静审不等于实际功能通过。当前效果是最近工作已可审阅和恢复，新的数值／视觉效果要等唯一执行后报告。

[正式执行卡]({target}M-LEDGER1_CARD.md) · [冻结协议]({target}protocol.json) · [来源记录]({target}author/source_preparation.json) · [独立正式静审]({target}author/final_static_review.json) · [上一阶段实际结果]({prior})

下一步仅申请 M-LEDGER1 一次 helper180秒／outer240秒、采样RSS8GiB，首错停止，无重试、修复重跑、延期或force。已关闭的M-LINK1不覆盖新分类／渲染。按这四态实际结果再决定全24态账本及外邻材料P诊断；本卡不实现压力、总边界力重建或有效夹持。全列切线、网格／域收敛、自由体／摩擦、正式标签／排名及HF5整体仍未完成。

<details>
<summary>本次更新前完整原文（历史状态不代表当前）</summary>

'''.encode('utf-8')
    new = text+old+b'\n</details>\n'
    path.write_bytes(new)
    assert new[len(text):len(text)+len(old)] == old
    rows.append(dict(path=rel,prior_sha256=sha256(old).hexdigest(),sha256=sha256(new).hexdigest(),bytes=len(new),prior_complete_bytes_preserved=True))
receipt = dict(status='current_source_preparation_documentation_pass',created_utc=datetime.now(timezone.utc).isoformat(),source_baseline_commit='909d7ba6a4bd3ba6bd11b97af830f4aeeef203c7',documents=rows,M_LEDGER1_authorized=False,M_LEDGER1_executed=False,new_ledger_or_render_calls=0)
REPORT.write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
(ROOT/STAGE/'author/documentation_receipt.json').write_bytes(REPORT.read_bytes())
(ROOT/STAGE/'author/write_current_docs.py.raw').write_bytes(Path(__file__).read_bytes())
print(json.dumps(receipt,ensure_ascii=False))
