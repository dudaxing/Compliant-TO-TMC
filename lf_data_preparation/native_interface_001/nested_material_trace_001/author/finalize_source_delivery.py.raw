"""Incremental delivery of unexecuted saved-P sources and their review."""
from datetime import datetime, timezone
from hashlib import sha256
import json
from pathlib import Path
import re
import subprocess

ROOT=Path('D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC')
EXT=Path(__file__).parent
BASE='808e719945f3a378704deea7c492eaaee50a39cd'
M='handoff/repository_manifest.json'
REL='lf_data_preparation/native_interface_001/nested_material_trace_001'
MODULE='hf_repo/src/hf_eval/saved_material_trace.py'
FRONTS={'docs/CURRENT_STATUS.md','docs/RESUME_DEVELOPMENT.md','lf_data_preparation/native_interface_001/nested_ledger_002/README.md'}
PREVIOUS=Path('D:/hf-native-workpiece-api-author-20261009/MLEDGER2_execution_review_001/publication_receipt.json')
OUT=EXT/'source_delivery_delta_verify.json'
git=lambda *args:subprocess.check_output(['git',*args],cwd=ROOT)
read=lambda path:json.loads(path.read_bytes())
assert not OUT.exists() and git('rev-parse','HEAD').decode().strip()==BASE
assert git('branch','--show-current').decode().strip()=='main'
assert git('remote','get-url','origin').decode().strip()=='https://github.com/dudaxing/Compliant-TO-TMC.git'
previous=read(PREVIOUS)
assert previous['published_commit']==BASE and previous['source_and_restore_clean']
old_raw=git('show',BASE+':'+M)
assert (ROOT/M).read_bytes()==old_raw
assert sha256(old_raw).hexdigest()==previous['manifest_sha256']=='a3f470d03d02735c6a2b09dc7ae01ac1e4ddb37004c8d91a90afa83e7586cbc6'
old=json.loads(old_raw)
entries={entry['path']:entry for entry in old['files']}
assert len(entries)==18438 and sum(e['bytes'] for e in entries.values())==9282222377
paths=[p.decode('utf-8') for p in git('ls-files','-z').split(b'\0') if p and p.decode('utf-8')!=M]
changed={p.decode('utf-8') for p in git('diff','--cached','--name-only','-z',BASE).split(b'\0') if p}
new=set(paths)-entries.keys()
assert not (entries.keys()-set(paths)) and changed & entries.keys()==FRONTS and changed==FRONTS|new
assert MODULE in new and all(p==MODULE or p.startswith(REL+'/') for p in new)
assert not git('diff','--name-only')
cache={}
def identity(name):
    if name not in cache:
        path=ROOT/name
        cache[name]=dict(path=name,bytes=path.stat().st_size,sha256=sha256(path.read_bytes()).hexdigest())
    return cache[name]
protocol=read(ROOT/REL/'protocol.json')
assert protocol['prepared'] and protocol['authorized'] is False and protocol['executed'] is False
assert len(protocol['bindings'])==31 and all(identity(p)['sha256']==pin for p,pin in protocol['bindings'].items())
assert [item['index'] for item in protocol['selected_states']]==[6,13]
assert protocol['expected_calls']==dict(NPZ_read_started=5,NPZ_read_completed=5,selected_array_fields=12,trace_started=2,trace_completed=2,PNG_writes=2)
assert (protocol['phases']['trace']['helper_seconds'],protocol['phases']['trace']['outer_seconds'],protocol['sampled_RSS_bytes'])==(180,240,8*1024**3)
assert not (ROOT/protocol['output_directory']).exists() and not (ROOT/REL/'trace_launch.json').exists()
preparation=read(ROOT/REL/'author/preparation_receipt.json')
assert preparation['status']=='source_prepared_not_executed' and not preparation['authorized'] and not preparation['executed']
assert preparation['preparation_actions']==dict(AST_parse_only=2,NPZ_decodes=0,trace_API_calls=0,new_PN_or_line_integrals=0,plots=0,kernel_or_solver_calls=0)
peers={}
for name in [REL+'/author/trace_static_physics_review.json',REL+'/author/final_source_review.json']:
    assert read(ROOT/name)['status'].startswith('pass')
    peers[name]=identity(name)['sha256']
links=[]
for name in [REL+'/README.md',REL+'/M-PTRACE1_CARD.md',*sorted(FRONTS)]:
    text=(ROOT/name).read_text(encoding='utf-8').split('<details>',1)[0]
    assert '\ufffd' not in text
    for target in re.findall(r'\]\(([^)]+)\)',text):
        if '://' in target or target.startswith('#'):continue
        path=((ROOT/name).parent/target.split('#')[0]).resolve()
        path.relative_to(ROOT)
        assert path.exists(),(name,target)
        links.append(dict(document=name,target=target))
delta=[identity(p) for p in sorted(changed)]
manifest=dict(old)
manifest.update(created_utc=datetime.now(timezone.utc).isoformat(),storage_stage='nested_saved_material_trace_source_prepared_001',
    previous_delivery_commit=BASE,files=[identity(p) if p in changed else entries[p] for p in paths])
raw=(json.dumps(manifest,ensure_ascii=False,indent=2)+'\n').encode('utf-8')
(ROOT/M).write_bytes(raw)
receipt=dict(status='incremental_source_delivery_pass',created_utc=datetime.now(timezone.utc).isoformat(),previous_delivery_commit=BASE,
    manifest_sha256=sha256(raw).hexdigest(),ordinary_manifest_files=len(paths),ordinary_manifest_bytes=sum(e['bytes'] for e in manifest['files']),
    new_files=len(new),changed_old_files=len(FRONTS),new_or_changed_files_directly_hashed=len(delta),delta_bytes=sum(e['bytes'] for e in delta),
    unchanged_manifest_entries_exactly_inherited=len(entries)-len(FRONTS),inherited_restoration_receipt=str(PREVIOUS),new_full_source_scan=False,
    protocol_checks=[dict(protocol=REL+'/protocol.json',protocol_sha256=identity(REL+'/protocol.json')['sha256'],bindings_checked=31)],
    peer_reviews=peers,delta_files=delta,local_links_checked=len(links),M_PTRACE1_authorized=False,M_PTRACE1_executed=False,
    NPZ_decodes_or_trace_or_render_in_delivery=0,original_science_and_qualification_unchanged=True,whole_HF5_complete=False)
with OUT.open('x',encoding='utf-8',newline='\n') as stream:stream.write(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({k:v for k,v in receipt.items() if k not in ('delta_files','peer_reviews')},ensure_ascii=False))
