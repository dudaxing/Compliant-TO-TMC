    {
      "path": "hf_repo/src/hf_eval/native_project.py",
      "bytes": 23187,
      "sha256": "4f1b4f772938bb870e8784fac881bad9a16f004fabf3b6e91ea9d2701c7601bc",
      "purpose": "Explicit geometry thickness enters model; material constants/kr do not already contain thickness; unit/extent/material declarations persisted.",
      "evidence": [
        {
          "line": 50,
          "text": "    _require(task[\"units\"] == UNITS, \"Project units must be mm, N, MPa and N mm\")"
        },
        {
          "line": 189,
          "text": "def build_native_project(geometry_file, task_dict: dict) -> Project:"
        },
        {
          "line": 198,
          "text": "    mapping = prepare_native_geometry(geometry_file)"
        },
        {
          "line": 200,
          "text": "    _require(task[\"geometry\"] == dict(geometry_id=geometry.geometry_id,"
        },
        {
          "line": 246,
          "text": "    lam = E * nu / ((1 + nu) * (1 - 2 * nu))"
        },
        {
          "line": 247,
          "text": "    mu = E / (2 * (1 + nu))"
        },
        {
          "line": 249,
          "text": "    kr = alpha * length**2 * (kappa + 4 * mu / 3)"
        },
        {
          "line": 251,
          "text": "    thickness = geometry.metadata[\"thickness_mm\"]"
        },
        {
          "line": 252,
          "text": "    model = TMCModel(arrays[\"coordinates_mm\"], arrays[\"connectivity\"], lam * factors,"
        },
        {
          "line": 253,
          "text": "                     mu * factors, kr, hx, hy, thickness, solid, fixed)"
        },
        {
          "line": 270,
          "text": "        force_energy_extent=geometry.metadata[\"model_extent\"][\"kind\"]+\" modeled geometry; no automatic doubling\")"
        },
        {
          "line": 278,
          "text": "        kappa_s_MPa=kappa, thickness_mm=thickness, third_medium_gamma=medium, alpha=alpha,"
        },
        {
          "line": 280,
          "text": "        force_scale_per_length=E * thickness)"
        },
        {
          "line": 302,
          "text": "                   dict(kr=model.kr, hx=model.hx, hy=model.hy, thickness=model.thickness, k_out=project.k_out,"
        },
        {
          "line": 316,
          "text": "        model_extent=deepcopy(project.geometry.metadata[\"model_extent\"]), units=deepcopy(UNITS),"
        },
        {
          "line": 319,
          "text": "        material=deepcopy(project.material), region_metadata=regions, qualification=deepcopy(project.qualification),"
        }
      ]
    },
    {
      "path": "hf_repo/src/hf_eval/tmc.py",
      "bytes": 19273,
      "sha256": "b2a1d4d449886667821e805cddeaf7bab3073d2d7a6cc1baeddfed05f407f025",
      "purpose": "Generic thickness default1 exists, but current native path passes explicit geometry thickness; operators receive it.",
      "evidence": [
        {
          "line": 46,
          "text": "    thickness: float = 1.0"
        },
        {
          "line": 59,
          "text": "        for name in (\"hx\", \"hy\", \"thickness\", \"kr\"):"
        },
        {
          "line": 88,
          "text": "        self.ops = operators(self.hx, self.hy, self.thickness)"
        }
      ]
    },
    {
      "path": "hf_repo/src/hf_eval/tmc_kernel.py",
      "bytes": 12018,
      "sha256": "dba45df22b36e2bf03bec4589d35ab6a37d151bf0c7d89b01fe6763964dfefd0",
      "purpose": "Only quadrature weights carry thickness as hx*hy*thickness/36; reference grad/Hessian are geometric.",
      "evidence": [
        {
          "line": 47,
          "text": "def operators(hx, hy, thickness=1.0):"
        },
        {
          "line": 51,
          "text": "    hessian[a,J,K] includes both xy and yx. Weights already include reference"
        },
        {
          "line": 52,
          "text": "    area Jacobian and thickness; sum(weights) = hx*hy*thickness."
        },
        {
          "line": 60,
          "text": "    grad[:, :, 0] = np.column_stack((eta-1, 1-eta, 1+eta, -1-eta)) / (2*hx)"
        },
        {
          "line": 61,
          "text": "    grad[:, :, 1] = np.column_stack((xi-1, -1-xi, 1+xi, 1-xi)) / (2*hy)"
        },
        {
          "line": 63,
          "text": "    hessian[:, 0, 1] = np.array([1., -1., 1., -1.]) / (hx*hy)"
        },
        {
          "line": 65,
          "text": "    weights = np.outer([1., 4., 1.], [1., 4., 1.]).ravel() * (hx*hy*thickness/36)"
        }
      ]
    },
    {
      "path": "hf_repo/src/hf_eval/split_kernel_invariants_hu.py",
      "bytes": 19752,
      "sha256": "d5f7d20a6ec0c92847d67f8782f4dcc89772fc4ea62797626b0beae7effabd9a",
      "purpose": "Current NumPy complete/mechanical response integrates material and Hu each with the same already thickness-inclusive weights, then scatters without another thickness factor.",
      "evidence": [
        {
          "line": 169,
          "text": "    # Keep product residuals in the quadrature and gradient contractions."
        },
        {
          "line": 170,
          "text": "    stress_grad = mul(_index(P, (..., None, slice(None), slice(None))),"
        },
        {
          "line": 173,
          "text": "    weighted_material = mul(ci.dd_from(weights[:, None, None], xp), element_material)"
        },
        {
          "line": 175,
          "text": "    material_pair = _reshape(ci.dd_sum(weighted_material, -3, xp), force_shape)"
        },
        {
          "line": 176,
          "text": "    action_pair = _reshape(ci.hessian_action_pair(Hu, hessian, xp), force_shape)"
        },
        {
          "line": 178,
          "text": "    scale = mul(ci.dd_from(kr, xp), ci.dd_sum(mul(ci.dd_from(weights, xp), exponential), -1, xp))"
        },
        {
          "line": 179,
          "text": "    regularization_pair = mul(_index(scale, (..., None)), action_pair)"
        },
        {
          "line": 180,
          "text": "    residual_pair = add(material_pair, regularization_pair)"
        },
        {
          "line": 289,
          "text": "        _, checked = _response(lift, fluctuation, reference[\"grad\"], reference[\"hessian\"],"
        },
        {
          "line": 290,
          "text": "                               reference[\"weights\"], lam_values, mu_values, float(kr_value), np,"
        },
        {
          "line": 315,
          "text": "def batch_response_split_numpy(lift_e, fluctuation_e, ops, lam, mu, kr):"
        },
        {
          "line": 323,
          "text": "    _, result = _numpy_response(lift_e, fluctuation_e, ops, lam, mu, kr)"
        },
        {
          "line": 327,
          "text": "def batch_response_split_mechanical_numpy(lift_e, fluctuation_e, ops, lam, mu, kr):"
        },
        {
          "line": 334,
          "text": "    _, result = _numpy_response(lift_e, fluctuation_e, ops, lam, mu, kr,"
        },
        {
          "line": 350,
          "text": "def _assemble_split(model, state, *, tangent, numpy=False, mechanical=False):"
        },
        {
          "line": 358,
          "text": "    args = (state.lift[model.edofs], state.fluctuation[model.edofs],"
        },
        {
          "line": 363,
          "text": "        fields = batch_response_split_numpy(*args) if numpy else batch_response_split(*args, tangent=tangent)"
        },
        {
          "line": 366,
          "text": "    internal = np.bincount(model.edofs.ravel(), weights=fields[\"residual\"].ravel(), minlength=model.ndof)"
        },
        {
          "line": 378,
          "text": "def assemble_split_numpy(model, state):"
        },
        {
          "line": 380,
          "text": "    return _assemble_split(model, state, tangent=False, numpy=True)"
        },
        {
          "line": 383,
          "text": "def assemble_split_mechanical_numpy(model, state):"
        },
        {
