"""Root-only M-LINK1 final documentation writer; do not run before peer PASS.

Writes only new RESULTS.md and three current prefixes, preserving each complete
old front document as exact bytes inside details. No API or scientific imports.
"""
import argparse
from datetime import datetime,timezone
import hashlib
import json
import os
from pathlib import Path

ROOT = Path("D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC")
STAGE = ROOT/"lf_data_preparation/native_interface_001/nested_link_001"
AUTHOR = Path(__file__).parent
sha = lambda path:hashlib.sha256(path.read_bytes()).hexdigest()
read = lambda path:json.loads(path.read_text(encoding="utf-8"))
relative = lambda path:path.relative_to(ROOT).as_posix()
PEER_SHA = "15ceacda5cbc2e88c4f07e96fc91eaea3e8e3d2b225a6e0dea1080ab5f86dd87"
SCOPE_SHA = "73d008a3d1a7b9c016edc55ed886e60af369ee480fd507354473f9b9536329bc"
FROZEN = {
    "lf_data_preparation/native_interface_001/nested_link_001/README.md":"4839cee1ba9fca05ea455ec527a9f4a549a16e874c0ebbcbb6fc2a3f46f8615e",
    "docs/CURRENT_STATUS.md":"4e98e2ef75294f13ed1350a566cbe73eea52104d0177f648023ca0c75aea681a",
    "docs/RESUME_DEVELOPMENT.md":"25b20a7c3c706414eef508ac0c75d4aadaaf0b487a8068a748983c61705ffbd1",
    "lf_data_preparation/native_interface_001/nested_link_001/protocol.json":"d5b918a5c6a7a11dac4c574c8b03cb7ac99aa30db7df5ae6cdb242314e0a6872",
    "lf_data_preparation/native_interface_001/nested_link_001/run_001/execution_receipt.json":"066cdc266a85eb830b4a118974930435470cd1f625c62e5ecf41c010a274c613",
    "lf_data_preparation/native_interface_001/nested_link_001/run_001/linked_response.json":"1fd03489c87888a5faca29ef0bade76eb3e143038bc4cb68bab7e733f0635ba4",
    "lf_data_preparation/native_interface_001/nested_link_001/run_001/delivery_index.json":"65302885c08ec944184f6364d230935272156fc6d42be76bbe5650d21acff48a",
    "lf_data_preparation/native_interface_001/nested_link_001/link_launch.json":"22f2d4ae06b1be008b40598860d2be7b78ceb937c30feb258ec31c3a9fd42a5e",
}

def link(label,target,document):
    return "["+label+"]("+Path(os.path.relpath(target,document.parent)).as_posix()+")"

def preserve_history(path,prefix):
    old = path.read_bytes()
    start = (prefix.rstrip()+"\n\n<details>\n<summary>本次更新前完整原文（历史状态不代表当前）</summary>\n\n").encode("utf-8")
    new = start+old+b"\n\n</details>\n"
    path.write_bytes(new)
    assert path.read_bytes()[len(start):len(start)+len(old)] == old
    return dict(path=relative(path),old_sha256=hashlib.sha256(old).hexdigest(),old_bytes=len(old),
        history_start_byte=len(start),history_end_byte_exclusive=len(start)+len(old),
        new_sha256=sha(path),new_bytes=len(new),whole_old_document_preserved_byte_exact=True)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--peer-report",type=Path,required=True)
    parser.add_argument("--peer-sha",required=True)
    args = parser.parse_args()
    peer_file = args.peer_report.resolve()
    if args.peer_sha != PEER_SHA or sha(peer_file) != PEER_SHA:
        raise ValueError("Root-supplied exact independent terminal report SHA differs")
    peer = read(peer_file)
    if peer["schema_version"] != "M-LINK1-independent-terminal-review-1.0" or peer["status"] != "pass_terminal_review" or peer["execution_status"] != "pass":
        raise ValueError("Independent M-LINK1 terminal PASS required before final documentation")
    if peer["stage"] != relative(STAGE) or peer["protocol_sha256"] != FROZEN[relative(STAGE/"protocol.json")]:
        raise ValueError("Peer report does not bind this exact stage/protocol")
    scope_file = AUTHOR/"physical_next_scope.json"
    if sha(scope_file) != SCOPE_SHA or read(scope_file)["status"] != "read_only_source_research_and_recommendation_no_execution_card":
        raise ValueError("Closed next-function planning source differs")
    for name,pin in FROZEN.items():
        if sha(ROOT/name) != pin:
            raise ValueError("Closed document input or complete history changed: "+name)
    if (STAGE/"RESULTS.md").exists():
        raise ValueError("Final result exists; no repeated history wrapping")
    helper,launch = read(STAGE/"run_001/execution_receipt.json"),read(STAGE/"link_launch.json")
    response,index = read(STAGE/"run_001/linked_response.json"),read(STAGE/"run_001/delivery_index.json")
    if helper["status"] != "pass" or launch["status"] != "pass" or launch["exit_code"] != 0 or launch["stop_reason"] is not None:
        raise ValueError("Closed unique execution did not pass")
    peak,end = response["maximum_loading_stroke"],response["requested_endpoint_response"]
    reference = response["independent_reference"]
    images = {Path(item["path"]).name:ROOT/item["path"] for item in index["images"]}
    resources = (f"helper {helper['elapsed_seconds']:.10f} s／outer {launch['elapsed_seconds']:.10f} s，"
        f"采样自身 RSS {helper['sampled_peak_RSS_bytes']} B／tree RSS {launch['peak_sampled_tree_RSS_bytes']} B")
    result_doc = STAGE/"RESULTS.md"
    image_text = "\n\n".join("!"+link(label,images[name],result_doc) for name,label in (
        ("actual_states.gif","原24态实际×1变形与工件节点力箭头"),
        ("comparison.png","原结构／钳尖与力曲线"),("distances_forces.png","原有限距离及力分量"),
        ("peak_fields.png","原峰值J／Hu／固体应变诊断"),("mesh_response_comparison.png","原同设计粗细网格六量曲线")))
    table_text = " · ".join(link(Path(item["path"]).name,ROOT/item["path"],result_doc) for item in index["tables"])
    values = lambda state:(state["R_input_N"],state["q_out_mm"],state["workpiece"]["force_on_lower_body_N"]["total"][1],state["minimum_J"])
    peak_values,end_values = values(peak),values(end)
    rows = "\n".join(f"| {label} | {a:.10g} | {b:.10g} |" for label,a,b in zip(
        ("下半模型输入反力R(N)","物理端口平均输出q_out(mm)","下半工件ON-body Fy(N)","保存积分点最低J"),peak_values,end_values))
    results = f"""# M-LINK1：已有参考与图件的关联入口已通过

2026-10-09，用户明确批准后唯一实际执行 PASS，exit0、stop_reason null；{resources}。35 份绑定保持。保存摘要开始／完成 1／1，response 写入 1 次、轻索引写入 1 次，新三份JSON共{peer['new_output_bytes']}B。独立终态审阅 PASS，{peer['checks_passed']}／{peer['checks_completed']}项为只读身份／来源／资源检查，并非新增科学试验；本阶段没有重试、修复重跑、延期或 force。

[新增关联 response](run_001/linked_response.json) · [轻交付索引](run_001/delivery_index.json) · [实际 helper 收据](run_001/execution_receipt.json) · [实际 outer 收据](link_launch.json) · [独立终态审阅](author/terminal_review.json) · [冻结卡](M-LINK1_CARD.md) · [冻结协议](protocol.json)。独立终态报告原字节 SHA：`{args.peer_sha}`。

## 整体目标、已有实现与这一步的理由

整体目标是从普通 LF 几何输入独立完成 HF 有限变形／第三介质接触(TMC)前向评估，获得可核对的加载／卸载、反力、结构变形与工件受力，并能在另一目录或计算机恢复继续开发。当前已实现固定方形工件完整24态加载／卸载、13440单元／27378DOF细网格、总／材料／Hu有符号弱式力、M-REF2自身48／48HP独立参考及M-VIEW1保存态实际变形图。

此前原生产 response 尚未关联随后生成的独立参考和图件。本步直接复用现有 `summarize_saved_native_result` 与 `write_native_response`，新增同身份 `linked_response.json` 和 `delivery_index.json`，让人工检查与恢复开发从一个入口到达已有证据。109行薄层不复制逐态数值核对，不新增科学测试、模型或绘图。

现有API实际匹配同一result／model／task全部24态、已有48HP记录和12条参考Python来源SHA；reference={reference['status']}、full_path_reference_pass={reference['full_path_reference_pass']}，views={response['views']['status']}。关联仅核对保存元数据和原字节，不重新审计大型HP／NPZ档案。原生产 response 的 producer 三个flags仍false，reference／views not_provided保持原历史事实；新增response保留这些false flags，同时单独记录新的matched artifact。

## 实际功能效果、资源与数值

索引把原result／response、本次新增response、既有M-REF2 summary、原raw view和phase、4PNG／24帧GIF及四份表用repo-relative路径与SHA串联。raw view仍有3PNG＋GIF；第四粗细PNG来自原phase `comparison.image`。原result、response、raw view、phase及图件未复制或改写；换目录恢复后从仓库根解析这些相对路径即可。

本次保存摘要API调用1次，写response1次，写索引1次。新增科学F／T／HP／模型／求解／JIT／LF／observer／render为0，依据冻结入口和stdlib保存元数据／来源／图件调用路径；没有动态hooks监控，不能笼统写“API0”。helper时间／RSS是最后checkpoint之后、成功收据构造和写入之前的快照；outer时间确认完整launcher终态。新增代码运行成本为上述0.2／0.39秒量级；linked response中原生产F开始443／完成386、T201／201及生产evaluation11428.1522s是M-CYCLE1历史，不是M-LINK1次数或耗时。

