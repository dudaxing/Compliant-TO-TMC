"""Archive reviewed full-ledger sources and update current handoff entries only."""
import argparse
import ast
from datetime import datetime, timezone
from hashlib import sha256
import json
from pathlib import Path
import subprocess

ROOT=Path('D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC')
EXT=Path('D:/hf-native-workpiece-api-author-20261009/MLEDGER2_source_prepare_001')
BASE='c4e9f785c3f4068479395002f7c1f3d5ae868b1a'
STAGE='lf_data_preparation/native_interface_001/nested_ledger_002'
OLD='lf_data_preparation/native_interface_001/nested_ledger_001'
PUB=Path('D:/hf-native-workpiece-api-author-20261009/MLEDGER1_execution_review_001/publication_receipt.json')
parser=argparse.ArgumentParser()
parser.add_argument('--worker-sha',required=True)
args=parser.parse_args()
read=lambda p:json.loads(p.read_bytes())
sha=lambda p:sha256(p.read_bytes()).hexdigest()
write=lambda p,v:p.write_bytes((json.dumps(v,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode('utf-8'))
git=lambda *a:subprocess.check_output(['git',*a],cwd=ROOT)
assert git('rev-parse','HEAD').decode().strip()==BASE and not git('status','--porcelain')
scope=read(EXT/'input_scope_review.json')
required=scope['required_input_bindings']
assert len(required)==35 and all(sha(ROOT/name)==pin for name,pin in required.items())
assert read(PUB)['published_commit']==BASE and read(PUB)['source_and_restore_clean']
worker_raw=(EXT/'execute_full_saved_ledger.py').read_bytes()
assert sha256(worker_raw).hexdigest()==args.worker_sha
tree=ast.parse(worker_raw.decode('utf-8'))
api_calls=[node for node in ast.walk(tree) if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id=='summarize_saved_workpiece_node_ledger']
assert len(api_calls)==1 and any(k.arg=='selected_states' and isinstance(k.value,ast.Constant) and k.value.value is None for k in api_calls[0].keywords)
old_protocol=read(ROOT/OLD/'protocol.json')
view=read(ROOT/old_protocol['view_summary_file'])
baseline={r['d_mm']:r for r in view['rows'] if r['leg'] in ('origin','loading')}
unloading={r['d_mm']:r for r in view['rows'] if r['leg']=='unloading'}
pairs=[dict(d_mm=d,baseline_index=baseline[d]['index'],baseline_leg=baseline[d]['leg'],baseline_state_sha256=baseline[d]['state_sha256'],
    unloading_index=unloading[d]['index'],unloading_leg=unloading[d]['leg'],unloading_state_sha256=unloading[d]['state_sha256']) for d in sorted(baseline.keys() & unloading.keys())]
assert len(pairs)==10 and pairs[0]['baseline_leg']=='origin'
stage=ROOT/STAGE
assert not stage.exists() and not (EXT/'preparation_receipt.json').exists()
stage.mkdir()
(stage/'author').mkdir()
for src,dst in [(EXT/'execute_full_saved_ledger.py',stage/'execute_full_saved_ledger.py'),
    (ROOT/OLD/'launch_ledger.py',stage/'launch_ledger.py'),(EXT/'M-LEDGER2_CARD.md',stage/'M-LEDGER2_CARD.md'),
    (EXT/'input_scope_review.json',stage/'author/input_scope_review.json'),(PUB,stage/'author/MLEDGER1_publication_receipt.json'),
    (EXT/'source_design_summary.json',stage/'author/source_design_summary.json')]:
    dst.write_bytes(src.read_bytes())
(stage/'author/prepare_source.py.raw').write_bytes(Path(__file__).read_bytes())
prepared_sources=[STAGE+'/execute_full_saved_ledger.py',STAGE+'/launch_ledger.py',STAGE+'/M-LEDGER2_CARD.md',STAGE+'/author/input_scope_review.json',STAGE+'/author/MLEDGER1_publication_receipt.json']
bindings=dict(required,**{rel:sha(ROOT/rel) for rel in prepared_sources})
assert len(bindings)==40
protocol=dict(schema_version='saved-fixed-square-full-ledger-card-1.0',status='source_prepared_not_authorized_not_executed',created_utc=datetime.now(timezone.utc).isoformat(),
    client_date='2026-10-11',client_timezone='Asia/Seoul',source_baseline_commit=BASE,stage=STAGE,selected_state_indices=list(range(24)),
    old_identity_registry_states=24,new_ledger_output_states=24,nodes_csv_file=old_protocol['nodes_csv_file'],linked_response_file=old_protocol['linked_response_file'],view_summary_file=old_protocol['view_summary_file'],
    nodal_files={str(i):old_protocol['nodes_csv_file'].rsplit('/',1)[0]+'/'+f'{i:03d}'+'/nodal.json' for i in range(24)},reference_ledger_file=OLD+'/run_001/ledger.json',
    paired_states=pairs,paired_category_rows=70,output_directory=STAGE+'/run_001',sampled_RSS_bytes=8*1024**3,
    phases={'ledger':dict(helper_seconds=180,outer_seconds=240,argv=[STAGE+'/execute_full_saved_ledger.py','--repo','.','--protocol',STAGE+'/protocol.json','--time-limit','180'])},
    existing_input_bindings=required,bindings=bindings,prepared_source_and_provenance_bindings={rel:bindings[rel] for rel in prepared_sources},
    original_group_roundoff_rule='8*2^-52*math.fsum(abs(original node force)), per state/component/axis; no absolute floor',
    direct_whole_comparison='Original six force texts converted with float+fsum reproduce closed nodal and case-summary whole-body exactly',
    overlap_comparison='Full state objects at0/8/13/23 equal existing M-LEDGER1 ledger; comparison only, no second classifier call',
    preparation_only=True,execution_authorized=False,execution_started=False,
    qualification='Full24 saved-table classification/old nodal-load closure only; no new mechanics, HP, total-boundary-force, effective-grip, pressure, mesh convergence or HF5 qualification',
    stop_contract='Once/first-error-stop/no retry repair rerun extension force; cooperative resources and sampled RSS, not OS hard cap',
    anticipated_outputs=['all_nodes.csv','category_loads.csv','ledger.json','paired_branch_differences.csv','path_branches.png','hu_target_path.png','execution_receipt.json'],
    pending='Independent exact source/card/protocol static reviews, publication/restoration, then separate human new-card execution authorization')
write(stage/'protocol.json',protocol)
prefix='''# 当前接续：M-LEDGER2全24保存态账本来源已准备，待授权（2026-10-11）

整体目标仍是独立HF有限变形／TMC前向评估，为外部研究提供可核对的反力、工件载荷和实际变形；在main开发，origin保持https://github.com/dudaxing/Compliant-TO-TMC.git。M-LEDGER1四态账本实际PASS、三PNG、2812节点行，已推送并恢复核对c4e9f785；该窗口已关闭，原24态循环／48HP／真实变形及原科学资格不改。

本次只准备新的全24保存态薄入口，复用公共读取函数原字节，锁定0..23顺序、16872原节点行／168类别行，六力原文本及微小卸载量保持、角点／切面交点独立、原whole精确与四组8eps·L1闭合合同不改。新caller尚未执行，不以AST／SHA静审代替运行通过。

依据原0.95mm保存结果的底边负Hu与角点正Hu抵消，下一卡将输出两张图：七类六分量的加载／卸载分支，及原24目标顺序Hu与精确配对Hu差。共有d有9个非零加载／卸载对，另有origin0与unloading0初始基线对，共70类别差行；没有unloading0.85／0.95／1.05／1.2，不插值。右下角node10638是角点类别子集，不能相加。保存差值不能自动称为耗散或收敛。

建议新窗口helper180秒／outer240秒／采样8GiB，唯一调用、两PNG，首错停止、无重试／修复重跑／延期／force。当前仅来源准备，尚未获本卡执行授权，尚无新24态账本或图件；不新增力核／HP／模型／平衡求解／NPZ或原观察器。节点弱式载荷不是接触压力，固定体力不证明有效夹持，HP仍限原模型／任务的原PORT方向。材料P诊断、总边界力、压力／有效夹持、自由体／摩擦、网格／域收敛、全列切线、正式标签排名及HF5仍待后续。

'''
fronts=['docs/CURRENT_STATUS.md','docs/RESUME_DEVELOPMENT.md',OLD+'/README.md']
history=[]
for rel in fronts:
    path=ROOT/rel
    old=path.read_bytes()
    assert old==git('show',BASE+':'+rel)
    import os
    card=os.path.relpath(stage/'M-LEDGER2_CARD.md',path.parent).replace('\\','/')
    prior=os.path.relpath(ROOT/OLD/'RESULTS.md',path.parent).replace('\\','/')
    banner=(prefix+f'[新执行卡与入口]({card}) · [M-LEDGER1实际结果与三图]({prior})\n\n<details>\n<summary>本次更新前完整原文（历史状态不代表当前）</summary>\n\n').encode('utf-8')
    new=banner+old+b'\n</details>\n'
    path.write_bytes(new)
    history.append(dict(path=rel,old_sha256=sha256(old).hexdigest(),new_sha256=sha256(new).hexdigest(),history_start_byte=len(banner),history_end_byte_exclusive=len(banner)+len(old),whole_old_document_preserved_byte_exact=True))
(stage/'README.md').write_bytes((prefix+'[执行卡](M-LEDGER2_CARD.md) · [冻结协议](protocol.json) · [薄入口](execute_full_saved_ledger.py) · [输入轻检](author/input_scope_review.json) · [M-LEDGER1实际结果](../nested_ledger_001/RESULTS.md)\n\n本阶段run_001／ledger_launch.json尚不存在；授权后才能使用卡中启动命令。\n').encode('utf-8'))
receipt=dict(status='source_preparation_written_no_candidate_or_render_execution',created_utc=datetime.now(timezone.utc).isoformat(),source_baseline_commit=BASE,
    worker_sha256=args.worker_sha,protocol_sha256=sha(stage/'protocol.json'),bindings=40,history_preservation=history,
    public_reader_byte_unchanged=sha(ROOT/'hf_repo/src/hf_eval/saved_workpiece_loads.py')=='2359a89d4969b98c68baa8b932fb0001c426b898004cb579f76ff8bc727c5070',
    ast_API_call_sites=1,selected_states_none=True,candidate_API_calls=0,new_classification_or_force_sum=0,rendering_calls=0,NPZ_HP_or_mechanics_calls=0,
    prepared_writer_sha256=sha(Path(__file__)),M_LEDGER2_authorized=False,M_LEDGER2_executed=False,original_science_and_qualification_unchanged=True)
write(stage/'author/preparation_receipt.json',receipt)
write(EXT/'preparation_receipt.json',receipt)
assert all(sha(ROOT/name)==pin for name,pin in bindings.items())
print(json.dumps(receipt,ensure_ascii=False))
