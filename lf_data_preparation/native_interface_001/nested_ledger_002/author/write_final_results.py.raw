"""Unique M-LEDGER2 documentation writer; root must review source before running.

Saved scalar formatting only. No candidate API, classification, force sum,
NPZ, HP, stress evaluation or rendering. Entire four old fronts stay byte-exact.
"""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path

ROOT = Path("D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC")
STAGE = ROOT / "lf_data_preparation/native_interface_001/nested_ledger_002"
AUTHOR = Path(__file__).parent
PEER_SHA = "b471e2cdf06706f9439ac9eee21cf63d1736038bccd27ae5520d51931a475396"
SCOPE_SHA = "9e6affded84f07f5f03aa4e2dc5a4b868d138d7c7d3e4220b002f7d48a5ed63e"
FRONTS = {
    "lf_data_preparation/native_interface_001/nested_ledger_002/README.md": "0597ca9df670888f3139653cdec08ad2980eee30fcf3cea48963364a819924c3",
    "docs/CURRENT_STATUS.md": "8d7dbf9b468d3d18282408130697c9e0fad71115ef88c60dd5ab49dd0d8962e7",
    "docs/RESUME_DEVELOPMENT.md": "f95bc1c3178ca1a4b6f1c8e878ecc21abe13c09a3d1b531680983311e86af2c3",
    "lf_data_preparation/native_interface_001/nested_ledger_001/README.md": "1b92e069e60d598e421dd84d4f2efaafb61792f8bed803243712cf6e684845cb",
}
INPUTS = {
    "protocol.json": "6aa1262756ecc036778f8346f8538ba5f1efc4027800b1365eff91151082d977",
    "run_001/execution_receipt.json": "e2aa1bdc551bc22cc2bb283af422f7494db95c1c2abab99b8cfe5305d67f98c6",
    "run_001/ledger.json": "1655c422118d56dab7c0d32681387e634be1b4cb46419a6968e9499fe20aec0e",
    "ledger_launch.json": "4611566004d1df087c1a0bd62d090d5e45c3eaa61e176e2ab6f6568721903295",
    "author/authorization_record.json": "984fa7125fa2d28e455d554ccca62cd856c05b5dd5bc95a6b419f847da62fd6e",
}
sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
read = lambda path: json.loads(path.read_text(encoding="utf-8"))
relative = lambda path: path.relative_to(ROOT).as_posix()
number = lambda value: format(value, ".15g")

def link(label, target, document):
    return "[" + label + "](" + Path(os.path.relpath(target, document.parent)).as_posix() + ")"

def write_new(path, raw):
    with path.open("xb") as stream:
        stream.write(raw)

def preserve_history(path, prefix):
    old = path.read_bytes()
    start = (prefix.rstrip() + "\n\n<details>\n<summary>本次更新前完整原文（历史状态不代表当前）</summary>\n\n").encode("utf-8")
    new = start + old + b"\n\n</details>\n"
    path.write_bytes(new)
    assert path.read_bytes()[len(start):len(start) + len(old)] == old
    return dict(path=relative(path), old_sha256=hashlib.sha256(old).hexdigest(), old_bytes=len(old),
        history_start_byte=len(start), history_end_byte_exclusive=len(start) + len(old),
        new_sha256=sha(path), new_bytes=len(new), whole_old_document_preserved_byte_exact=True)

def main():
    peer_file, scope_file = STAGE / "author/terminal_review.json", AUTHOR / "physical_next_scope.json"
    assert sha(peer_file) == PEER_SHA and sha(scope_file) == SCOPE_SHA
    peer, scope = read(peer_file), read(scope_file)
    assert peer["schema_version"] == "m-ledger2-independent-terminal-review-1.0" and peer["status"] == "pass"
    for name, pin in FRONTS.items():
        assert sha(ROOT / name) == pin, name
    for name, pin in INPUTS.items():
        assert sha(STAGE / name) == pin, name
    result_doc, receipt_file = STAGE / "RESULTS.md", AUTHOR / "documentation_receipt.json"
    copies = {STAGE / "author/physical_next_scope.json": scope_file, STAGE / "author/write_final_results.py.raw": Path(__file__)}
    for path in (result_doc, receipt_file, STAGE / "author/final_documentation_receipt.json", *copies):
        assert not path.exists(), "Unique documentation target already exists: " + str(path)
    helper, launch, ledger = read(STAGE / "run_001/execution_receipt.json"), read(STAGE / "ledger_launch.json"), read(STAGE / "run_001/ledger.json")
    assert helper["status"] == launch["status"] == "pass" and launch["exit_code"] == 0 and launch["stop_reason"] is None
    states = ledger["states"]
    resources = f"helper {helper['elapsed_seconds']:.10f} s／outer {launch['elapsed_seconds']:.10f} s，采样自身 RSS {helper['sampled_peak_RSS_bytes']} B／tree RSS {launch['peak_sampled_tree_RSS_bytes']} B"
    vectors = lambda force: " | ".join(number(value) for part in ("total", "material", "regularization") for value in force[part])
    whole_rows = "\n".join("| " + str(state["identity"]["index"]) + "／" + state["identity"]["leg"] + "／" + number(state["identity"]["d_mm"]) + " | " + vectors(state["whole"]["force_on_body_N"]) + " |" for state in states)
    hu_rows = []
    for case in scope["hu_key_cases"]:
        identity, corner = case["identity"], case["right_bottom_node_saved_row"]
        values = [value for name in ("bottom_side_interior", "physical_corner") for value in case[name]["force_on_body_N"]["regularization"]]
        values += [float(corner["regularization_Fx_N"]), float(corner["regularization_Fy_N"])] + case["whole_saved_force_on_body_N"]["regularization"]
        hu_rows.append("| " + str(identity["index"]) + "／" + identity["leg"] + "／" + number(identity["d_mm"]) + " | " + " | ".join(number(value) for value in values) + " |")
    maxima_rows = "\n".join("| " + item["column"].replace("delta_unloading_minus_baseline_", "").replace("regularization", "Hu") + " | " + item["category"] + " | " + number(item["d_mm"]) + " | " + str(item["baseline"]["index"]) + "／" + item["baseline"]["leg"] + " → " + str(item["unloading"]["index"]) + "／unloading | " + number(item["signed_saved_delta_N"]) + " |" for item in scope["saved_delta_maxima"])
    gif = ROOT / "functional_views/native_nested_cycle_20261009/complete_001/run_001/view/fixed_square/actual_states.gif"
    results = f"""# M-LEDGER2：全24保存态账本与加载／卸载分支已通过

2026-10-11（Asia/Seoul），用户明确批准“批准按 M-LEDGER2 卡执行”后的唯一启动实际PASS：exit0、stop_reason null、ledger开始／完成1／1、PNG写入2；{resources}。40份绑定保持，无重试、修复重跑、延期或force。本窗口已经关闭。

[全24账本JSON](run_001/ledger.json) · [原节点文本CSV](run_001/all_nodes.csv) · [七类六分量CSV](run_001/category_loads.csv) · [精确同d配对及六差CSV](run_001/paired_branch_differences.csv) · [helper收据](run_001/execution_receipt.json) · [outer收据](ledger_launch.json) · [stdout](ledger_stdout.log) · [直接授权记录](author/authorization_record.json) · [独立终态审阅](author/terminal_review.json) · [只读物理解读／下一步依据](author/physical_next_scope.json) · [原冻结卡](M-LEDGER2_CARD.md) · [原协议](protocol.json)。终态报告原字节SHA`{PEER_SHA}`，物理解读SHA`{SCOPE_SHA}`。原卡／协议的prepared和授权记录execution_started=false保留执行前历史；实际收据证明当前运行事实。

## 整体目标、已有工作与这一步的理由

整体目标是读取普通LF几何，独立完成HF有限变形／第三介质接触(TMC)前向评估，提供可核对的反力、工件载荷、实际变形和加载／卸载响应，供外部研究层比较，并能跨目录／机器恢复继续开发。HF不优化、不调用dmftd；继续main，origin保持https://github.com/dudaxing/Compliant-TO-TMC.git。

此前已有h0.5细网格24接受态完整循环、M-VIEW1真实变形、M-REF2自身48次保存态HP参考和M-LINK1关联入口。M-LEDGER1四态账本显示底边负Hu与角点正Hu抵消，整体净值不足以解释局部载荷。本次复用原[公共stdlib函数](../../../hf_repo/src/hf_eval/saved_workpiece_loads.py)，由192行[薄caller](execute_full_saved_ledger.py)唯一调用selected_states=None，完成原0..23全24态保存表处理，并展示载荷抵消如何随原目标序列及卸载改变。

原703身体节点每态完整，16872原节点行、168七类行。原身份／node ID／参考坐标及六力字符串保持，包括signed zero和卸载微小残量；七类互斥，角点与物理／切面交点独立，不分摊到相邻侧。原whole直接精确对账与旧四组8·2^-52·节点L1闭合通过，无绝对误差地板、不强制total=material+Hu。原0／8／13／23完整保存态对象与M-LEDGER1逐项一致，直接比较已算数据，未二次分类或求和。

独立终态审阅核对保存身份、原文字／rawSHA、已存闭合记录与配对标量减法，PASS；没有重新分类、fsum、HP或绘图，不是新增独立科学试验。主Agent已实际查看两PNG，原图保持。公共模块原qualification字符串保留，其中no full24 qualification指力核科学资格；caller的processing_scope明确本次确已完成全24保存表处理，两者不能混淆。

## 实际功能效果、资源与完整数值入口

新增保存表分类／汇总1次、精确配对六分量标量差及两Matplotlib图。新增NPZ／F／T／HP／模型构造／平衡求解／原观察器为0，是冻结来源调用路径依据，未动态监控mechanical hooks。本卡没有重求解旧循环，未重画旧位置图／峰值图／GIF。helper时间／RSS是末checkpoint后、成功收据构造／写入前快照；outer为完整launcher终态。原180／240秒、采样8GiB额度保持；RSS采样不是OS硬限制，依赖和严格科学源码未改。

物理任务保持84×40mm下半域、h0.5、固定方形中心(71,40)mm／边长18mm、身体x62..80／y31..40，E1MPa、ν0.3、厚度20mm，原平均输入0→1.2→0mm。以下是已存整体载荷，15位有效数字仅作紧凑显示；CSV／JSON保存完整精度和原节点文字。N单位的节点弱式力已经含原厚度，不再乘厚度。

