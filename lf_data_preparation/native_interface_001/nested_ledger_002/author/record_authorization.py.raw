"""Record the direct M-LEDGER2 approval before the unique frozen launch."""
from datetime import datetime, timezone
from hashlib import sha256
import json
from pathlib import Path
import subprocess

ROOT=Path('D:/Coding/Diversity TO/Compliant-Nonlinear-TMC-O/.github_handoff/Compliant-TO-TMC')
STAGE=ROOT/'lf_data_preparation/native_interface_001/nested_ledger_002'
BASE='362a79dcf68d5822778bc36093c28a9960566139'
PUB=Path('D:/hf-native-workpiece-api-author-20261009/MLEDGER2_source_prepare_001/publication_receipt.json')
sha=lambda p:sha256(p.read_bytes()).hexdigest()
protocol=json.loads((STAGE/'protocol.json').read_bytes())
assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT).decode().strip()==BASE
assert sha(STAGE/'protocol.json')=='6aa1262756ecc036778f8346f8538ba5f1efc4027800b1365eff91151082d977'
assert sha(STAGE/'M-LEDGER2_CARD.md')=='cbb809b1d0becb73247ec398e41c4dca47686f910d8cc20b8ec138146d5e4224'
assert len(protocol['bindings'])==40 and all(sha(ROOT/rel)==pin for rel,pin in protocol['bindings'].items())
assert not (STAGE/'run_001').exists() and not (STAGE/'ledger_launch.json').exists()
for name in ['authorization_record.json','record_authorization.py.raw','preexecution_publication_receipt.json']:
    assert not (STAGE/'author'/name).exists()
published=json.loads(PUB.read_bytes())
assert published['published_commit']==BASE and published['source_and_restore_clean']
record=dict(schema_version='m-ledger2-direct-execution-authorization-1.0',created_utc=datetime.now(timezone.utc).isoformat(),
    direct_user_message='批准按 M-LEDGER2 卡执行',prepared_commit=BASE,card_sha256=sha(STAGE/'M-LEDGER2_CARD.md'),protocol_sha256=sha(STAGE/'protocol.json'),
    checked_bindings=40,helper_seconds=180,outer_seconds=240,sampled_RSS_bytes=8*1024**3,selected_state_indices=list(range(24)),
    ledger_calls_authorized=1,PNG_writes_authorized=2,paired_strokes=10,paired_category_rows=70,
    stop_contract='First error stops; no retry, repair rerun, extension or force',
    execution_started=False,record_scope='Direct approval and raw binding precheck only; preexecution snapshot, no candidate call',
    source_publication_receipt_sha256=sha(PUB),original_physics_and_qualification_unchanged=True)
(STAGE/'author/record_authorization.py.raw').write_bytes(Path(__file__).read_bytes())
(STAGE/'author/preexecution_publication_receipt.json').write_bytes(PUB.read_bytes())
with (STAGE/'author/authorization_record.json').open('x',encoding='utf-8',newline='\n') as stream:
    stream.write(json.dumps(record,ensure_ascii=False,indent=2)+'\n')
print(json.dumps(record,ensure_ascii=False))
